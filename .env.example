# ============================================
# Ollama LAN Gateway Configuration
# ============================================

# Gateway bind settings
GATEWAY_HOST=10.0.0.181
GATEWAY_PORT=8001

# Ollama settings
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama API request timeout in seconds (default: 300)
OLLAMA_TIMEOUT=300

# Model registry path (optional)
# Set to empty string or omit to disable registry and use Ollama models directly
# When enabled, maps custom model IDs to Ollama model names
MODEL_REGISTRY_PATH=models/registry.json

# Security: API key (REQUIRED for production)
# Generate a strong random key for production use
GATEWAY_API_KEY=change-me-please

# Security: IP allow-list
# Examples:
#   "*" - allow all (dev only, NOT for production)
#   "192.168.0.0/24" - allow subnet
#   "10.0.0.2,10.0.0.3" - specific IPs
#   "192.168.0.0/24,10.0.0.0/24" - multiple subnets
IP_ALLOWLIST=192.168.0.0/24,10.0.0.0/24

# Allow unauthenticated /health checks
# Set to false to require API key for health endpoint
REQUIRE_AUTH_FOR_HEALTH=false

# Logging configuration
LOG_LEVEL=INFO
LOG_DIR=logs
